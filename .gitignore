minecraftinstance.json

# Drive stubs, not content
docs/scratch/

# Client configuration is per-user, never pack behaviour. Scripts under
# kubejs/client_scripts/ are code, not configuration, and stay tracked.
**/*client*.toml
**/*client*.snbt
**/*client*.json
**/*client*.properties
config/InventoryHUD/
config/justzoom/
config/runelic.json

# Profiler output, regenerated per run
config/spark/
config/observable.json
observable_announce

# Per-save state, keyed by world/player UUID
gtceu/prospection_cache/
config/chunky/tasks/
config/emi.css

# Python bytecode from the test harness
__pycache__/

# Gradle build state for `mod/` (ADR-0014). The jar it produces lands in mods/, already ignored.
.gradle/
mod/build/
build/
*.log

.probe

# Agent worktrees. Each is a second checkout of this repo, not pack content, and a
# `git add -A` from the repo root would otherwise commit every session's copy of it.
.claude/worktrees/
.rtk/
