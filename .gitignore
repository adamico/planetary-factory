# Folders/wildcards
!kubejs/data
!servers.json
.DS_Store
.DS_Store?
.mixin.out
*.dll
*.jar.disabled
*.jar.meta
**/*.bak
**/*.exe
**/*.jar
# ...except the Gradle wrapper, which is how the first-party mod is built.
!gradle/wrapper/gradle-wrapper.jar
**/*.zip
# ...except the filter pack, which is pack content and must ship.
!kubejs/data/*.zip
backups
classes
crash-reports
downloads
dumps
libraries
llibrary
local
logs
# The jar set is tracked as a packwiz manifest (ADR-0024). The jars themselves stay
# out of git, but packwiz writes one `.pw.toml` metafile per mod into `mods/` and
# those ARE the manifest. Written as `mods/*` rather than a bare `mods`, because git
# will not re-include a file beneath an excluded *directory* — a negation under the
# bare form fails silently, leaving the manifest untracked.
mods/*
!mods/*.pw.toml
profilekeys
saves
screenshots
world
world_backup

